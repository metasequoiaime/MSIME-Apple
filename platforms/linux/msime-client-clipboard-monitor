#!/usr/bin/env python3
"""Observe text clipboard changes while the configured history preference is enabled."""
import argparse
import json
import os
from pathlib import Path
import select
import shutil
import subprocess
import time


def document(path):
    with path.open("rb") as source:
        raw = source.read(16385)
    if len(raw) > 16384:
        raise ValueError()
    value = json.loads(raw)
    if not isinstance(value, dict):
        raise ValueError()
    return value


def history_directory(options):
    config = document(options)
    directory = Path(config["preferences_directory"])
    if not directory.is_absolute():
        raise ValueError()
    history = config.get("clipboard_history_path")
    if history and Path(history) != directory / "clipboard_history.json":
        raise ValueError()
    preferences = document(directory / "preferences.json")
    if preferences.get("format_version") != 1 or not isinstance(preferences.get("preferences"), dict):
        raise ValueError()
    return directory if preferences["preferences"].get("clipboard_history") is True else None


def read_command(args):
    process = subprocess.Popen(args, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                               stderr=subprocess.DEVNULL)
    data = bytearray()
    deadline = time.monotonic() + 1
    try:
        while time.monotonic() < deadline:
            if not select.select([process.stdout], [], [], max(0, deadline - time.monotonic()))[0]:
                return None
            chunk = os.read(process.stdout.fileno(), 4097 - len(data))
            if not chunk:
                if process.wait(timeout=max(0.01, deadline - time.monotonic())) != 0:
                    return None
                text = data.decode("utf-8").rstrip("\r\n")
                return text if text and "\0" not in text else None
            data.extend(chunk)
            if len(data) > 4096:
                return None
    finally:
        if process.poll() is None:
            process.kill()
        process.wait()
        process.stdout.close()
    return None


def clipboard_text():
    commands = []
    if os.environ.get("WAYLAND_DISPLAY"):
        commands.append(["wl-paste", "--no-newline", "--type", "text"])
    if os.environ.get("DISPLAY"):
        commands.extend([["xclip", "-selection", "clipboard", "-o"],
                         ["xsel", "--clipboard", "--output"]])
    for args in commands:
        if shutil.which(args[0]):
            try:
                text = read_command(args)
                if text is not None:
                    return text
            except (OSError, ValueError, subprocess.SubprocessError):
                pass
    return None


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("options", type=Path)
    args = parser.parse_args()
    if not args.options.is_absolute():
        parser.error("runtime options path must be absolute")
    capture = Path(__file__).resolve().parent / "msime-client-clipboard-capture"
    last = None
    while True:
        try:
            directory = history_directory(args.options)
            if directory is None:
                last = None
            else:
                text = clipboard_text()
                identity = (str(directory), text)
                if text is not None and identity != last:
                    result = subprocess.run([str(capture), str(directory)], input=text.encode(),
                                            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                                            timeout=2)
                    if result.returncode == 0:
                        last = identity
        except (OSError, ValueError, KeyError, TypeError, subprocess.SubprocessError):
            last = None
        time.sleep(0.75)


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        pass
