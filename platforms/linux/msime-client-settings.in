#!/usr/bin/env sh
set -eu

if [ "${1:-}" = "--help" ]; then
  echo "Usage: msime-client-settings [--panel settings|about|dictionary|handwriting|keyboard|emoji|clipboard|voice|cloud-dictionary|cloud-clipboard] [desktop arguments...]"
  exit 0
fi
if [ "${1:-}" = "--panel" ]; then
  case "${2:-}" in
    settings|about|dictionary|handwriting|keyboard|emoji|clipboard|voice|cloud-dictionary|cloud-clipboard)
      MSIME_CLIENT_PANEL=$2
      export MSIME_CLIENT_PANEL
      shift 2
      ;;
    *) echo "MSIME panel name is missing or unsupported" >&2; exit 2 ;;
  esac
fi

# The About menu opens an existing settings section, not a separate panel.
if [ "${MSIME_CLIENT_PANEL:-}" = "about" ]; then
  MSIME_CLIENT_PANEL=settings
  MSIME_CLIENT_SETTINGS_PAGE=about
  export MSIME_CLIENT_PANEL MSIME_CLIENT_SETTINGS_PAGE
fi

# Local dictionary is a settings section rather than a separate desktop host.
if [ "${MSIME_CLIENT_PANEL:-}" = "dictionary" ]; then
  MSIME_CLIENT_PANEL=settings
  MSIME_CLIENT_SETTINGS_PAGE=dictionary
  export MSIME_CLIENT_PANEL MSIME_CLIENT_SETTINGS_PAGE
fi

# Share the cross-platform surface route with hosts that understand the newer
# route contract while retaining MSIME_CLIENT_PANEL compatibility. A settings
# section is a "settings:<category>" route; emitting the bare section name would
# not parse, because only a surface may head a route.
if [ -n "${MSIME_CLIENT_PANEL:-}" ]; then
  if [ -n "${MSIME_CLIENT_SETTINGS_PAGE:-}" ]; then
    MSIME_CLIENT_ROUTE=settings:$MSIME_CLIENT_SETTINGS_PAGE
  else
    MSIME_CLIENT_ROUTE=$MSIME_CLIENT_PANEL
  fi
  export MSIME_CLIENT_ROUTE
fi

if [ -n "${MSIME_CLIENT_HOST_OPTIONS:-}" ]; then
  config=$MSIME_CLIENT_HOST_OPTIONS
elif [ -n "${MSIME_IBUS_OPTIONS:-}" ]; then
  config=$MSIME_IBUS_OPTIONS
else
  config=${XDG_CONFIG_HOME:-$HOME/.config}/msime-client/runtime-options.json
  case "$config" in
    /*) ;;
    *) echo "MSIME user configuration directory must be absolute" >&2; exit 1 ;;
  esac
  # Match the IBus component's installed configuration fallback. An existing
  # unreadable file or dangling symlink is a broken user configuration.
  if [ ! -e "$config" ] && [ ! -L "$config" ]; then
    config='@MSIME_SETTINGS_SYSTEM_CONFIG@'
  fi
fi

case "$config" in
  /*) ;;
  *) echo "MSIME runtime options must be an absolute path: $config" >&2; exit 1 ;;
esac
if [ ! -r "$config" ]; then
  echo "MSIME runtime options not found: $config" >&2
  exit 1
fi

launcher_path=$0
link_depth=0
while [ -L "$launcher_path" ]; do
  link_depth=$((link_depth + 1))
  [ "$link_depth" -le 32 ] || { echo "MSIME settings launcher symlink chain is too deep: $0" >&2; exit 1; }
  link=$(readlink "$launcher_path")
  case "$link" in
    /*) launcher_path=$link ;;
    *) launcher_path=$(dirname -- "$launcher_path")/$link ;;
  esac
done
launcher_dir=$(CDPATH= cd -- "$(dirname -- "$launcher_path")" && pwd)
export MSIME_CLIENT_HOST_OPTIONS=$config
exec "$launcher_dir/msime-client-desktop" "$@"
