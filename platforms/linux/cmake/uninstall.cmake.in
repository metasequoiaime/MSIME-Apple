# Remove only files recorded by this build's installation. Configuration and user state survive: unlike the Windows uninstaller, which deletes the data directory it owns, a CMake uninstall cannot tell which users prepared state from this installation, so it never removes theirs.
set(manifest "@CMAKE_CURRENT_BINARY_DIR@/install_manifest.txt")
if(NOT EXISTS "${manifest}")
  message(FATAL_ERROR "No install manifest; use the build directory that performed the installation")
endif()

if(NOT DEFINED MSIME_UNINSTALL_PREFIX)
  set(MSIME_UNINSTALL_PREFIX "@CMAKE_INSTALL_PREFIX@")
endif()
if(NOT IS_ABSOLUTE "${MSIME_UNINSTALL_PREFIX}")
  message(FATAL_ERROR "MSIME_UNINSTALL_PREFIX must be absolute")
endif()
set(staging "$ENV{DESTDIR}")
if(NOT staging STREQUAL "" AND NOT IS_ABSOLUTE "${staging}")
  message(FATAL_ERROR "DESTDIR must be absolute")
endif()
set(prefix "${staging}${MSIME_UNINSTALL_PREFIX}")
cmake_path(NORMAL_PATH prefix)
if(prefix STREQUAL "/")
  message(FATAL_ERROR "Refusing to uninstall with the filesystem root as prefix")
endif()
file(REAL_PATH "${prefix}" real_prefix)
# The XDG autostart entry of a /usr prefix is the one file installed outside the prefix, under /etc/xdg/autostart, so that configured directory is accepted as a second root. For other prefixes it lies inside the prefix and moves with MSIME_UNINSTALL_PREFIX. A tree may not have the directory at all.
set(autostart_destination "@MSIME_XDG_AUTOSTART_DIR@")
if(IS_ABSOLUTE "${autostart_destination}")
  set(autostart "${staging}${autostart_destination}")
else()
  set(autostart "${prefix}/${autostart_destination}")
endif()
cmake_path(NORMAL_PATH autostart)
set(real_autostart "${autostart}")
if(EXISTS "${autostart}")
  file(REAL_PATH "${autostart}" real_autostart)
endif()
file(STRINGS "${manifest}" installed_files)
set(removals)
# Preflight the entire manifest before removing anything.
foreach(installed IN LISTS installed_files)
  if(installed STREQUAL "")
    continue()
  endif()
  if(NOT IS_ABSOLUTE "${installed}")
    message(FATAL_ERROR "Install manifest contains a relative path")
  endif()
  # This file can contain local changes made after installation.
  if(installed MATCHES "/msime-client/runtime-options\\.json$")
    message(STATUS "Preserving installed runtime configuration")
    continue()
  endif()
  set(target "${staging}${installed}")
  cmake_path(NORMAL_PATH target)
  cmake_path(IS_PREFIX prefix "${target}" NORMALIZE inside_prefix)
  cmake_path(IS_PREFIX autostart "${target}" NORMALIZE inside_autostart)
  if((NOT inside_prefix AND NOT inside_autostart) OR target STREQUAL prefix OR target STREQUAL autostart)
    message(FATAL_ERROR "Install manifest extends outside the uninstall prefix; specify the original installation prefix")
  endif()
  # A symlink at the file itself is removed, never followed. Parent-directory
  # symlinks must still resolve within the installation tree.
  cmake_path(GET target PARENT_PATH parent)
  file(REAL_PATH "${parent}" real_parent)
  cmake_path(IS_PREFIX real_prefix "${real_parent}" NORMALIZE parent_inside)
  cmake_path(IS_PREFIX real_autostart "${real_parent}" NORMALIZE parent_inside_autostart)
  if(NOT parent_inside AND NOT parent_inside_autostart)
    message(FATAL_ERROR "An installed file's parent resolves outside the installation tree")
  endif()
  if(IS_DIRECTORY "${target}" AND NOT IS_SYMLINK "${target}")
    message(FATAL_ERROR "An installed file has been replaced by a directory; refusing recursive removal")
  endif()
  list(APPEND removals "${target}")
endforeach()

# The Windows uninstaller stops the IME processes and removes their logon task. The Linux counterpart is the user units msime-client-setup enabled, which would otherwise keep restarting against deleted programs. An uninstall run as the user disables them in that user's manager, one unit at a time so an absent one does not stop the rest; a root or staged uninstall cannot reach other users' managers and prints the command instead.
set(user_units @MSIME_USER_UNIT_LIST@)
list(JOIN user_units " " user_unit_list)
execute_process(COMMAND id -u OUTPUT_VARIABLE user_id OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
find_program(systemctl_program systemctl)
if(staging STREQUAL "" AND systemctl_program AND NOT user_id STREQUAL "0" AND DEFINED ENV{XDG_RUNTIME_DIR})
  foreach(unit IN LISTS user_units)
    execute_process(COMMAND "${systemctl_program}" --user disable --now "${unit}" OUTPUT_QUIET ERROR_QUIET)
  endforeach()
  message(STATUS "MSIME user services stopped and disabled for this user")
else()
  message(STATUS "Each user who ran msime-client-setup should stop its services: systemctl --user disable --now ${user_unit_list}")
endif()

foreach(target IN LISTS removals)
  if(EXISTS "${target}" OR IS_SYMLINK "${target}")
    file(REMOVE "${target}")
    if(EXISTS "${target}" OR IS_SYMLINK "${target}")
      message(FATAL_ERROR "Could not remove an installed file; use the permissions required by the original installation")
    endif()
  endif()
endforeach()
message(STATUS "MSIME program files removed; runtime configuration and user data preserved")
