#!/usr/bin/env sh
set -eu
config=${MSIME_IBUS_OPTIONS:-${XDG_CONFIG_HOME:-$HOME/.config}/msime-client/runtime-options.json}
if [ ! -r "$config" ]; then
  echo "MSIME runtime options not found: $config" >&2
  exit 1
fi
launcher_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
exec "$launcher_dir/msime-client-ibus" "$config"
