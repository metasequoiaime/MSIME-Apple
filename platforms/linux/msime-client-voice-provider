class NoRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, req, fp, code, msg, headers, newurl):
        return None


def bounded_text(value):
    if not isinstance(value, str):
        return ""
    value = value.strip()
    if any((ord(c) < 32 and c not in "\n\t") or 127 <= ord(c) <= 159 for c in value):
        return ""
    return value.encode()[:4096].decode("utf-8", errors="ignore")


def post(config, body, content_type, timeout):
    request = urllib.request.Request(config["endpoint"], body, headers={
        "Content-Type": content_type, "Authorization": "Bearer " + config["token"],
        "User-Agent": "MSIME-Client"})
    with urllib.request.build_opener(NoRedirect()).open(request, timeout=timeout) as response:
        raw = response.read(1024 * 1024 + 1)
    if len(raw) > 1024 * 1024:
        raise ValueError("response too large")
    return json.loads(raw)


def normalize_voice_language(value):
    if not isinstance(value, str) or len(value) > 64 or not value.isascii():
        raise ValueError("invalid recognition language")
    tag = value.strip().lower().replace("_", "-")
    if tag in ("", "auto"):
        return "auto"
    parts = tag.split("-")
    if (len(parts[0]) != 2 or not parts[0].isalpha()
            or any(not 2 <= len(part) <= 8 or not part.isalnum() for part in parts[1:])):
        raise ValueError("invalid recognition language")
    # Keep the host's existing Chinese identifier; multipart APIs take the
    # base ISO language rather than the locale used by desktop controls.
    return "zh-cn" if parts[0] == "zh" else parts[0]


def multipart(pcm, config, language):
    if config["provider"] == "siliconflow":
        pcm = b"\0" * (RATE * 2 // 5) + pcm + b"\0" * (RATE * 2 // 5)
        pcm = pcm.ljust(RATE * 2, b"\0")
    if len(pcm) + 44 > MAX_AUDIO:
        raise ValueError("audio too large")
    buffer = io.BytesIO()
    with wave.open(buffer, "wb") as wav:
        wav.setnchannels(1)
        wav.setsampwidth(2)
        wav.setframerate(RATE)
        wav.writeframes(pcm)
    audio = buffer.getvalue()
    fields = [("model", config["model"])]
    if config["provider"] != "siliconflow" and language != "auto":
        fields.append(("language", "zh" if language == "zh-cn" else language))
    while True:
        boundary = "----MSIMEVoice" + uuid.uuid4().hex
        if boundary.encode() not in audio and all(boundary not in v for _, v in fields):
            break
    body = bytearray()
    for key, value in fields:
        body.extend((f'--{boundary}\r\nContent-Disposition: form-data; name="{key}"\r\n\r\n{value}\r\n').encode())
    body.extend((f'--{boundary}\r\nContent-Disposition: form-data; name="file"; filename="audio.wav"\r\n'
                 'Content-Type: audio/wav\r\n\r\n').encode())
    body.extend(audio)
    body.extend((f'\r\n--{boundary}--\r\n').encode())
    return bytes(body), "multipart/form-data; boundary=" + boundary


def transcribe(pcm, config, language, session):
    body, content_type = multipart(pcm, config, normalize_voice_language(language))
    for attempt in range(2 if config["provider"] == "siliconflow" else 1):
        if session.cancelled.is_set():
            return ""
        try:
            result = post(config, body, content_type, 60)
            return bounded_text(result.get("text") or result.get("transcription") or
                                (result.get("result") or {}).get("text"))
        except urllib.error.HTTPError as error:
            if config["provider"] != "siliconflow" or error.code < 500 or attempt:
                raise
        except urllib.error.URLError:
            if config["provider"] != "siliconflow" or attempt:
                raise
        if session.cancelled.wait(0.4):
            return ""
    return ""


def polish_prompt(options):
    preset = options.get("polish_prompt_id") or "cleanup"
    if preset in ("custom", "custom_1"):
        return options.get("polish_prompt_custom_1") or options.get("polish_prompt") or PROMPTS["cleanup"]
    if preset in ("custom_2", "custom_3"):
        return options.get("polish_prompt_" + preset) or PROMPTS["cleanup"]
    return PROMPTS.get(preset, PROMPTS["cleanup"])


def polish(text, config, options):
    if not config or not (options.get("polish_enabled") or options.get("polish_text")):
        return text
    if not matching(config, options, "polish"):
        return text
    prompt = polish_prompt(options)
    if not isinstance(prompt, str) or len(prompt.encode()) > 8192:
        return text
    body = {"model": config["model"], "stream": False, "messages": [
        {"role": "system", "content": prompt},
        {"role": "user", "content": "<asr_text>\n" + text + "\n</asr_text>"}]}
    if config["provider"] == "siliconflow":
        body["enable_thinking"] = False
    elif config["provider"] == "deepseek":
        body["thinking"] = {"type": "disabled"}
    try:
        result = post(config, json.dumps(body).encode(), "application/json", 3)
        return bounded_text(result["choices"][0]["message"]["content"]) or text
    except Exception:
        return text


def matching(config, options, prefix):
    requested = options.get(prefix + "_provider")
    return ((not requested or provider_id(requested) == config["provider"]) and
            (not options.get(prefix + "_model") or options[prefix + "_model"] == config["model"]))


def select_profile(config, options, name):
    requested = options.get(name + "_provider")
    requested = provider_id(requested) if requested else None
    entry = config.get(name)
    if requested and (entry is None or requested != entry["provider"]):
        entry = config.get(name + "_profiles", {}).get(requested)
    return entry if entry and matching(entry, options, name) else None


def capture_command(backend, device=None):
    if device is not None and (not device or len(device) > 1024 or
                               any(ord(c) < 32 for c in device)):
        raise ValueError("invalid capture device")
    if backend in ("auto", "pulse") and shutil.which("parec"):
        return ["parec", "--raw", "--format=s16le", "--rate=16000", "--channels=1", "--latency-msec=20"] + (
            ["--device=" + device] if device else [])
    if backend in ("auto", "pipewire") and shutil.which("pw-cat"):
        return ["pw-cat", "--record", "--raw", "--format=s16", "--rate=16000",
                "--channels=1", "--latency=20ms"] + (
                    ["--target=" + device] if device else []) + ["-"]
    if backend in ("auto", "alsa") and shutil.which("arecord"):
        return ["arecord", "-q", "-t", "raw", "-f", "S16_LE", "-r", "16000", "-c", "1"] + (
            ["--device=" + device] if device else [])
    raise ValueError("install parec, pw-cat, or arecord for the selected capture backend")


def request_capture_command(options, default_backend, default_device):
    backend = options.get("capture_backend", "")
    device = options.get("capture_device", "")
    if not isinstance(backend, str) or backend not in ("", "auto", "pulse", "pipewire", "alsa"):
        raise ValueError("invalid capture backend")
    if (not isinstance(device, str) or len(device) > 128 or len(device.encode("utf-8")) > 512
            or any(ord(c) < 32 or 127 <= ord(c) <= 159 for c in device)):
        raise ValueError("invalid capture device")
    # A selected backend uses its system default when no device is supplied.
    # An entirely inherited selection preserves the service's command-line device.
    return capture_command(backend or default_backend,
                           device or (default_device if not backend else None))


def command(args, data=None, timeout=2):
    return subprocess.run(args, input=data, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                          timeout=timeout, check=True).stdout


def cue_audio(start):
    # The installed path is relative to bin so custom prefixes stay relocatable.
    try:
        from msime_voice_paths import CUE_DIRECTORY
        directory = Path(__file__).resolve().parent / CUE_DIRECTORY
    except ImportError:
        directory = Path(__file__).resolve().parent / "data" / "voice"
    try:
        with (directory / ("start.pcm" if start else "end.pcm")).open("rb") as source:
            audio = source.read(RATE * 2 * 4 + 1)
        if audio and len(audio) <= RATE * 2 * 4 and len(audio) % 2 == 0:
            return audio
    except OSError:
        pass
    # Keep copied standalone scripts usable if their optional assets are absent.
    frames = RATE // 12
    return b"".join(struct.pack("<h", int(2500 * math.sin(2 * math.pi * (880 if start else 660) * i / RATE) *
                                        math.sin(math.pi * i / frames))) for i in range(frames))


def cue(options, start):
    if not options.get("sound_enabled", True) or not options.get("start_sound" if start else "end_sound", True):
        return
    args = (["paplay", "--raw", "--format=s16le", "--rate=16000", "--channels=1"] if shutil.which("paplay") else
            ["pw-cat", "--playback", "--raw", "--format=s16", "--rate=16000", "--channels=1", "-"] if shutil.which("pw-cat") else
            ["aplay", "-q", "-t", "raw", "-f", "S16_LE", "-r", "16000", "-c", "1"] if shutil.which("aplay") else None)
    if args:
        audio = cue_audio(start)
        try:
            command(args, audio, timeout=max(2, len(audio) / (RATE * 2) + 1))
        except Exception:
            pass


def sink_inputs():
    return json.loads(command(["pactl", "--format=json", "list", "sink-inputs"], timeout=0.5))


def stream_identity(stream):
    props = stream.get("properties", {})
    if props.get("object.serial") is not None:
        return (stream["index"], props["object.serial"])
    return (stream["index"], props.get("application.process.id"), props.get("application.name"))


def pipewire_sink_inputs(wanted=None, session=None, excluded=None, indices=None):
    nodes = json.loads(command(["pw-dump"], timeout=0.5))
    streams = []
    for node in nodes:
        if session is not None and session.stopped.is_set():
            break
        if node.get("type") != "PipeWire:Interface:Node":
            continue
        props = node.get("info", {}).get("props", {})
        if props.get("media.class") != "Stream/Output/Audio" or props.get("object.serial") is None:
            continue
        index = node.get("id")
        if type(index) is not int or index < 0:
            continue
        if indices is not None and index not in indices:
            continue
        if wanted is not None and (index, props["object.serial"]) not in wanted:
            continue
        if excluded is not None and (index, props["object.serial"]) in excluded:
            continue
        # Use the session manager's current state, rather than assuming that
        # missing Props in a graph snapshot means an unmuted stream.
        try:
            volume = command(["wpctl", "get-volume", str(index)], timeout=0.5)
            if not volume.startswith(b"Volume:"):
                if indices is not None:
                    raise ValueError()
                continue
            streams.append({"index": index, "properties": props,
                            "mute": b"[MUTED]" in volume})
        except Exception:
            if indices is not None:
                raise
            continue
        if len(streams) >= (len(wanted) if wanted is not None else len(indices) if indices is not None else 32):
            break
    return streams


def set_stream_mute(backend, index, muted):
    args = (["wpctl", "set-mute", str(index), str(int(muted))] if backend == "pipewire" else
            ["pactl", "set-sink-input-mute", str(index), str(int(muted))])
    command(args, timeout=0.5)


class AudioMuteJournal:
    """Private recovery metadata only; never store application names or audio."""
    def __init__(self, path):
        self.path = path
        self.entries = {}
        self.available = True
        try:
            self.boot = Path("/proc/sys/kernel/random/boot_id").read_text().strip()
            descriptor = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
            with os.fdopen(descriptor, "rb") as source:
                info = os.fstat(source.fileno())
                if (not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid() or
                        info.st_mode & 0o077 or info.st_size > 65536):
                    raise ValueError()
                document = json.loads(source.read(65537))
            if document.get("version") != 1 or not isinstance(document.get("entries"), dict):
                raise ValueError()
            entries = document["entries"]
            if len(entries) > 256:
                raise ValueError()
            for key, digest in entries.items():
                backend, index = key.split(":", 1)
                if (backend not in ("pulse", "pipewire") or not index.isascii() or not index.isdecimal()
                        or len(index) > 10 or not isinstance(digest, str) or len(digest) != 64
                        or any(c not in "0123456789abcdef" for c in digest)):
                    raise ValueError()
            self.entries = entries if document.get("boot") == self.boot else {}
        except FileNotFoundError:
            if not hasattr(self, "boot"):
                self.available = False
        except Exception:
            # Preserve unreadable metadata and avoid additional unrecoverable mutes.
            self.available = False

    def fingerprint(self, backend, stream):
        props = stream.get("properties", {})
        pid = str(props.get("application.process.id", ""))
        if not pid.isascii() or not pid.isdecimal() or len(pid) > 10:
            raise ValueError()
        # A reused stream index or PID must not restore an unrelated application.
        process = Path("/proc") / pid
        owner = process.stat().st_uid
        start = (process / "stat").read_text().rsplit(")", 1)[1].split()[19]
        identity = [self.boot, backend, stream_identity(stream), owner, start]
        return hashlib.sha256(json.dumps(identity, separators=(",", ":")).encode()).hexdigest()

    def persist(self):
        temporary = None
        try:
            with tempfile.NamedTemporaryFile(mode="w", dir=self.path.parent, delete=False) as output:
                temporary = Path(output.name)
                json.dump({"version": 1, "boot": self.boot, "entries": self.entries}, output)
                output.flush()
                os.fsync(output.fileno())
            os.replace(temporary, self.path)
            directory = os.open(self.path.parent, os.O_RDONLY | os.O_DIRECTORY)
            try:
                os.fsync(directory)
            finally:
                os.close(directory)
        finally:
            if temporary is not None:
                temporary.unlink(missing_ok=True)

    def record(self, backend, stream):
        if not self.available:
            return False
        key = backend + ":" + str(stream["index"])
        try:
            digest = self.fingerprint(backend, stream)
            # Pending restoration is never overwritten by a new mute operation.
            if key in self.entries or len(self.entries) >= 256:
                return False
            self.entries[key] = digest
            self.persist()
            return True
        except Exception:
            self.available = False
            return False

    def recover(self):
        if not self.available or not self.entries:
            return
        for backend in ("pulse", "pipewire"):
            keys = [key for key in self.entries if key.startswith(backend + ":")]
            if not keys:
                continue
            try:
                streams = (pipewire_sink_inputs(indices={int(key.split(":")[1]) for key in keys})
                           if backend == "pipewire" else sink_inputs())
                current = {backend + ":" + str(stream["index"]): stream for stream in streams}
                for key in keys:
                    stream = current.get(key)
                    try:
                        if stream is not None and self.fingerprint(backend, stream) == self.entries[key]:
                            if stream.get("mute"):
                                set_stream_mute(backend, stream["index"], False)
                        del self.entries[key]
                    except Exception:
                        # Enumeration, identity or restore failures retain the entry.
                        continue
                self.persist()
            except Exception:
                continue


def mute_audio(enabled, session, muted=None, seen=None):
    muted = [] if muted is None else muted
    seen = set() if seen is None else seen
    if not enabled:
        return muted
    streams = None
    backend = "pulse"
    if shutil.which("pactl"):
        try:
            streams = sink_inputs()
        except Exception:
            pass
    if streams is None and shutil.which("pw-dump") and shutil.which("wpctl"):
        backend = "pipewire"
        try:
            streams = pipewire_sink_inputs(session=session, excluded={identity for backend, identity in seen
                                                                     if backend == "pipewire"})
        except Exception:
            pass
    if streams is not None:
        try:
            unseen = [stream for stream in streams if (backend, stream_identity(stream)) not in seen]
            for stream in unseen[:32]:
                if session.stopped.is_set():
                    break
                identity = (backend, stream_identity(stream))
                if identity in seen:
                    continue
                if len(seen) >= 1024 or len(muted) >= 256:
                    break
                if not stream.get("mute"):
                    journal = getattr(session, "mute_journal", None)
                    if journal is not None and not journal.record(backend, stream):
                        seen.add(identity)
                        continue
                    set_stream_mute(backend, stream["index"], True)
                    muted.append(identity)
                seen.add(identity)
        except Exception:
            pass
    return muted


class AudioMuteWatch:
    """Track newly created playback streams without blocking PCM collection."""
    def __init__(self, session, muted, seen):
        self.halted = threading.Event()
        self.session = session
        self.mute_journal = getattr(session, "mute_journal", None)
        self.muted = muted
        self.seen = seen
        # Existing helpers only require a stopped event with is_set().
        self.stopped = self
        self.thread = threading.Thread(target=self.run, daemon=True)
        self.thread.start()

    def is_set(self):
        return self.halted.is_set() or self.session.stopped.is_set()

    def run(self):
        while not self.halted.wait(0.5):
            if self.is_set():
                break
            mute_audio(True, self, self.muted, self.seen)

    def stop(self):
        self.halted.set()
        # Join before restoration so no late mute can race the restore pass.
        self.thread.join()


def restore_audio(muted):
    if not muted:
        return
    backends = {backend for backend, _ in muted}
    if len(backends) > 1:
        for backend in backends:
            restore_audio([entry for entry in muted if entry[0] == backend])
        return
    try:
        backend = muted[0][0]
        streams = (pipewire_sink_inputs(wanted={identity for _, identity in muted})
                   if backend == "pipewire" else sink_inputs())
        for stream in streams:
            if stream.get("mute") and (backend, stream_identity(stream)) in muted:
                try:
                    set_stream_mute(backend, stream["index"], False)
                except Exception:
                    continue
    except Exception:
        pass


class Session:
    def __init__(self):
        self.stopped = threading.Event()
        self.cancelled = threading.Event()
        self.finished = threading.Event()
        self.capture_done = threading.Event()

    def control(self, cancel):
        if cancel:
            self.cancelled.set()
        self.stopped.set()


def capture(session, connection, args, seconds, options, on_audio=None, on_tick=None, on_level=None):
    pcm = bytearray()
    recorded = 0
    pending_sample = b""
    limit = min(seconds * RATE * 2, MAX_AUDIO - 44)
    process = None
    muted = []
    mute_watch = None
    level_energy = 0
    level_samples = 0
    last_level = time.monotonic()

    def append(chunk):
        nonlocal recorded, pending_sample, level_energy, level_samples, last_level
        if session.cancelled.is_set():
            return
        # Pipe reads can split a 16-bit sample between chunks. Never forward
        # that partial sample to a streaming recognizer or count it as audio.
        chunk = (pending_sample + chunk)[:max(0, limit - recorded)]
        aligned = len(chunk) // 2 * 2
        pending_sample = chunk[aligned:]
        chunk = chunk[:aligned]
        if not chunk:
            return
        recorded += len(chunk)
        if on_level:
            # Match Windows AudioCallback's RMS floor and visual compression.
            level_energy += sum(sample * sample for (sample,) in struct.iter_unpack("<h", chunk))
            level_samples += len(chunk) // 2
            now = time.monotonic()
            if now - last_level >= 0.1:
                rms = math.sqrt(level_energy / level_samples) / 32768
                on_level(min(1.0, max(0.0, rms - 0.004) * 14.0) ** 0.55)
                level_energy = level_samples = 0
                last_level = now
        if on_audio:
            on_audio(chunk)
        else:
            pcm.extend(chunk)

    try:
        if session.stopped.is_set():
            return b"", 0
        cue(options, True)
        if session.stopped.is_set():
            return b"", 0
        seen_streams = set()
        if getattr(session, "mute_journal", None) is not None:
            session.mute_journal.recover()
        muted = mute_audio(options.get("mute_system_audio", False), session, seen=seen_streams)
        if options.get("mute_system_audio", False) and not session.stopped.is_set():
            mute_watch = AudioMuteWatch(session, muted, seen_streams)
        if session.stopped.is_set():
            return b"", 0
        process = subprocess.Popen(args, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                                   stdin=subprocess.DEVNULL)
        os.set_blocking(process.stdout.fileno(), False)
        deadline = time.monotonic() + seconds
        last_audio = time.monotonic()
        while not session.stopped.is_set() and time.monotonic() < deadline:
            if on_tick:
                on_tick()
                if session.stopped.is_set():
                    break
            ready, _, _ = select.select([process.stdout, connection], [], [], 0.1)
            if connection in ready:
                session.control(True)
                break
            if process.stdout in ready:
                try:
                    chunk = os.read(process.stdout.fileno(), 8192)
                except BlockingIOError:
                    chunk = None
                if chunk == b"":
                    raise ValueError("capture stopped unexpectedly")
                if chunk:
                    last_audio = time.monotonic()
                    append(chunk)
                    if recorded >= limit:
                        break
            # Silence still produces PCM samples. No bytes means a stalled
            # device or recording process, not a user pausing between words.
            if time.monotonic() - last_audio >= 5:
                raise ValueError("capture produced no audio")
        process.terminate()
        # Keep buffered audio on normal stop, but never let communicate()
        # accumulate unbounded output from a stuck process or its descendants.
        drain_deadline = time.monotonic() + 1
        while not session.cancelled.is_set() and recorded < limit and time.monotonic() < drain_deadline:
            if on_tick:
                on_tick()
                if session.cancelled.is_set():
                    break
            elif select.select([connection], [], [], 0)[0]:
                session.control(True)
                break
            if not select.select([process.stdout], [], [], 0.05)[0]:
                continue
            try:
                chunk = os.read(process.stdout.fileno(), 8192)
            except BlockingIOError:
                continue
            if not chunk:
                break
            append(chunk)
        return (bytes(pcm), recorded) if not session.cancelled.is_set() else (b"", 0)
    finally:
        try:
            if process:
                try:
                    if process.poll() is None:
                        try:
                            process.terminate()
                        except ProcessLookupError:
                            pass
                        try:
                            process.wait(timeout=1)
                        except subprocess.TimeoutExpired:
                            process.kill()
                            process.wait()
                finally:
                    process.stdout.close()
        finally:
            # Process cleanup must not prevent restoring streams we muted.
            try:
                try:
                    if mute_watch:
                        mute_watch.stop()
                finally:
                    restore_audio(muted)
                    if getattr(session, "mute_journal", None) is not None:
                        session.mute_journal.recover()
            finally:
                try:
                    cue(options, False)
                finally:
                    session.capture_done.set()


class Handler(socketserver.StreamRequestHandler):
    def send(self, generation, text="", ok=True, kind="final"):
        self.wfile.write(json.dumps({"generation": generation, "text": text, "type": kind,
                                    "ok": ok}, ensure_ascii=False).encode() + b"\n")
        self.wfile.flush()

    def level(self, generation, value):
        self.wfile.write(json.dumps({"generation": generation, "type": "level",
                                    "level": round(value, 4), "ok": True}).encode() + b"\n")
        self.wfile.flush()

    def status(self, query, generation, phase):
        # Older hosts interpret unknown event types as terminal results.
        # Emit status only after explicit capability negotiation.
        events = query.get("events")
        if query.get("stream") and isinstance(events, list) and "status" in events:
            self.wfile.write(json.dumps({"generation": generation, "type": "status",
                                        "phase": phase, "ok": True}).encode() + b"\n")
            self.wfile.flush()

    def handle(self):
        self.request.settimeout(2)
        pid, uid, _ = struct.unpack("3i", self.request.getsockopt(socket.SOL_SOCKET, socket.SO_PEERCRED, 12))
        if uid != os.getuid():
            return
        session = None
        generation = 0
        key = None
        voice_slot = False
        recognizer = None
        try:
            line = self.rfile.readline(16385)
            if len(line) > 16384 or not line.endswith(b"\n"):
                return
            request = json.loads(line)
            query = request["query"]
            generation = query["generation"]
            if request.get("version") != 1 or type(generation) is not int or not 0 <= generation < 2**64:
                return
            key = (pid, generation)
            kind = request.get("kind")
            if kind in ("voice_stop", "voice_cancel"):
                with self.server.lock:
                    current = self.server.sessions.get(key)
                    if current:
                        current.control(kind == "voice_cancel")
                    else:
                        self.server.pending = {k: v for k, v in self.server.pending.items() if v[0] > time.monotonic()}
                        if len(self.server.pending) < 64:
                            old = self.server.pending.get(key)
                            self.server.pending[key] = (time.monotonic() + 5,
                                kind == "voice_cancel" or bool(old and old[1]))
                return
            if kind != "voice":
                return
            options = query.get("options") or {}
            language = normalize_voice_language(query.get("language", "zh-cn"))
            if not isinstance(options, dict):
                self.send(generation, ok=False)
                return
            if any(not isinstance(value, (bool, str)) for value in options.values()):
                self.send(generation, ok=False)
                return
            capture_args = request_capture_command(options, self.server.capture_backend,
                                                   self.server.capture_device)
            # One validated snapshot owns both recognition and polishing for
            # this recording, even if the private file changes mid-session.
            config = load_config(self.server.config_path)
            asr = select_profile(config, options, "asr")
            if asr is None:
                self.send(generation, ok=False)
                return
            polish_config = select_profile(config, options, "polish")
            if asr["provider"] == "doubao":
                from msime_voice_doubao import websocket_dependency
                websocket_dependency()
            if (asr["provider"] == "doubao" and options.get("asr_resource_id") and
                options["asr_resource_id"] != asr["resource_id"]):
                self.send(generation, ok=False)
                return
            # Reserve request-handler capacity for stop/cancel messages while
            # previous recordings are waiting for network recognition.
            voice_slot = self.server.voice_slots.acquire(blocking=False)
            if not voice_slot:
                self.send(generation, ok=False)
                return
            with self.server.lock:
                if key in self.server.sessions or self.server.closing:
                    self.send(generation, ok=False)
                    return
                session = Session()
                session.mute_journal = self.server.mute_journal
                pending = self.server.pending.pop(key, None)
                if pending and pending[0] > time.monotonic():
                    session.control(pending[1])
                self.server.sessions[key] = session
            if not self.server.microphone.acquire(blocking=False):
                self.send(generation, ok=False)
                return
            try:
                if asr["provider"] == "doubao" and not session.stopped.is_set():
                    from msime_voice_doubao import DoubaoStream
                    recognizer = DoubaoStream(asr, options, session.cancelled)
                last_partial = ""

                def tick():
                    nonlocal last_partial
                    if session.cancelled.is_set():
                        return
                    if select.select([self.request], [], [], 0)[0]:
                        session.control(True)
                        return
                    text = bounded_text(recognizer.latest())
                    if query.get("stream") and text and text != last_partial:
                        self.send(generation, text, kind="partial")
                        last_partial = text
                    if recognizer.done.is_set():
                        session.stopped.set()

                if not session.stopped.is_set():
                    self.status(query, generation, "recording")
                events = query.get("events")
                level_update = (lambda value: self.level(generation, value)) if (
                    query.get("stream") and isinstance(events, list) and "level" in events) else None
                pcm, recorded = capture(session, self.request, capture_args, self.server.seconds, options,
                                        recognizer.feed if recognizer else None, tick if recognizer else None,
                                        level_update)
            finally:
                # Also covers recognizer initialization failures before capture().
                self.server.microphone.release()
                session.capture_done.set()
            if session.cancelled.is_set() or recorded < RATE // 4 * 2:
                self.send(generation)
                return
            self.status(query, generation, "recognizing")
            text = (bounded_text(recognizer.finish(tick)) if recognizer else
                    transcribe(pcm, asr, language, session))
            del pcm
            if session.cancelled.is_set():
                self.send(generation)
                return
            if text and query.get("stream") and (options.get("polish_enabled") or options.get("polish_text")):
                self.send(generation, text, kind="partial")
            if text:
                if polish_config and (options.get("polish_enabled") or options.get("polish_text")):
                    self.status(query, generation, "polishing")
                text = polish(text, polish_config, options)
            self.send(generation, "" if session.cancelled.is_set() else text)
        except Exception:
            try:
                self.send(generation, ok=False)
            except Exception:
                pass
        finally:
            try:
                if recognizer:
                    recognizer.close()
            except Exception:
                # Never expose transport errors or let them retain a voice slot.
                pass
            finally:
                try:
                    if session:
                        with self.server.lock:
                            if self.server.sessions.get(key) is session:
                                self.server.sessions.pop(key, None)
                        session.finished.set()
                        session.capture_done.set()
                finally:
                    if voice_slot:
                        self.server.voice_slots.release()


class Server(socketserver.ThreadingMixIn, socketserver.UnixStreamServer):
    daemon_threads = True

    def process_request(self, request, address):
        if not self.slots.acquire(blocking=False):
            self.shutdown_request(request)
            return
        try:
            super().process_request(request, address)
        except Exception:
            self.slots.release()
            raise

    def process_request_thread(self, request, address):
        try:
            super().process_request_thread(request, address)
        finally:
            self.slots.release()

    def handle_error(self, request, address):
        pass


def load_config(path):
    # Nonblocking open prevents a replaced FIFO from holding a request slot.
    # Validate the opened file itself so atomic replacement remains supported.
    descriptor = os.open(path, os.O_RDONLY | os.O_NONBLOCK | os.O_CLOEXEC)
    with os.fdopen(descriptor, "rb") as source:
        info = os.fstat(source.fileno())
        if info.st_uid != os.getuid() or info.st_mode & 0o077 or not stat.S_ISREG(info.st_mode):
            raise ValueError()
        raw = source.read(16385)
        after = os.fstat(source.fileno())
        identity = lambda value: (value.st_dev, value.st_ino, value.st_size,
                                  value.st_mtime_ns, value.st_ctime_ns, value.st_mode, value.st_uid)
        if len(raw) > 16384 or identity(info) != identity(after):
            raise ValueError()
    config = json.loads(raw.decode("utf-8"))
    if not isinstance(config, dict) or not isinstance(config.get("asr"), dict):
        raise ValueError()
    entries = []
    for name in ("asr", "polish"):
        default = config.get(name)
        if default is not None:
            if not isinstance(default, dict):
                raise ValueError()
            default["provider"] = provider_id(default.get("provider"))
            entries.append((name, default))
        profiles = config.get(name + "_profiles", {})
        allowed = ASR_PROVIDERS if name == "asr" else POLISH_PROVIDERS
        if not isinstance(profiles, dict) or len(profiles) > len(allowed):
            raise ValueError()
        normalized = {}
        for original, entry in profiles.items():
            provider = provider_id(original)
            if (provider not in allowed or provider in normalized or not isinstance(entry, dict)
                    or provider_id(entry.get("provider", provider)) != provider
                    or (default is not None and default.get("provider") == provider)):
                raise ValueError()
            entry["provider"] = provider
            normalized[provider] = entry
            entries.append((name, entry))
        config[name + "_profiles"] = normalized
    for name, entry in entries:
        if any(not isinstance(entry.get(k), str) or not entry[k].strip() for k in ("provider", "token")):
            raise ValueError()
        if entry["provider"] not in (ASR_PROVIDERS if name == "asr" else POLISH_PROVIDERS):
            raise ValueError()
        endpoint = entry.get("endpoint", "")
        if not isinstance(endpoint, str):
            raise ValueError()
        if not endpoint:
            entry["endpoint"] = DEFAULT_ENDPOINTS[name][entry["provider"]]
        model = entry.get("model", "")
        if not isinstance(model, str):
            raise ValueError()
        if not model:
            entry["model"] = DEFAULT_MODELS[name][entry["provider"]]
        doubao = name == "asr" and entry["provider"] == "doubao"
        if doubao:
            entry.setdefault("model", "")
            entry.setdefault("resource_id", "volc.seedasr.sauc.duration")
            entry.setdefault("app_key", "")
            for key in ("model", "resource_id", "app_key"):
                value = entry[key]
                if not isinstance(value, str) or len(value) > 512 or any(ord(c) < 33 or ord(c) > 126 for c in value):
                    raise ValueError()
            if not entry["resource_id"] or entry["app_key"].startswith(("<", "FAKESECRET_")):
                raise ValueError()
        elif not isinstance(entry.get("model"), str) or not entry["model"].strip():
            raise ValueError()
        token = entry["token"]
        if token.startswith(("<", "FAKESECRET_")) or any(ord(c) < 33 or ord(c) > 126 for c in token):
            raise ValueError()
        url = urllib.parse.urlsplit(entry["endpoint"])
        if url.scheme != ("wss" if doubao else "https") or not url.hostname or url.username or url.password or url.fragment:
            raise ValueError()
    return config



def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("socket", type=Path)
    parser.add_argument("--config", type=Path, required=True, help="owner-only JSON with asr/polish defaults and optional asr_profiles/polish_profiles")
    parser.add_argument("--capture", choices=("auto", "pulse", "pipewire", "alsa"), default="auto")
    parser.add_argument("--capture-device", help="PulseAudio source, PipeWire node name/serial, or ALSA PCM device")
    parser.add_argument("--max-recording-seconds", type=int, default=300, help="1–600 seconds, default 300")
    args = parser.parse_args()
    try:
        config = load_config(args.config)
        if config["asr"]["provider"] == "doubao" or "doubao" in config.get("asr_profiles", {}):
            from msime_voice_doubao import websocket_dependency
            websocket_dependency()
        capture_args = capture_command(args.capture, args.capture_device)
        parent = args.socket.parent.stat()
        if (not args.socket.is_absolute() or parent.st_uid != os.getuid() or parent.st_mode & 0o077 or
            not stat.S_ISDIR(parent.st_mode) or not 1 <= args.max_recording_seconds <= 600):
            raise ValueError()
    except Exception:
        parser.error("invalid private configuration/socket directory, capture backend, recording limit, or missing websockets 15.x for Doubao")
    os.umask(0o077)
    try:
        service_lock = claim_socket(args.socket)
    except (OSError, ValueError):
        parser.error("voice service is already running or its socket cannot be recovered")
    try:
        server = Server(str(args.socket), Handler)
    except Exception:
        os.close(service_lock)
        raise
    server.mute_journal = AudioMuteJournal(args.socket.with_name(args.socket.name + ".audio-mute.json"))
    server.mute_journal.recover()
    server.config_path = args.config.absolute()
    server.capture_args = capture_args
    server.capture_backend = args.capture
    server.capture_device = args.capture_device
    server.seconds = args.max_recording_seconds
    server.lock = threading.Lock()
    server.microphone = threading.BoundedSemaphore(1)
    server.slots = threading.BoundedSemaphore(8)
    server.voice_slots = threading.BoundedSemaphore(4)
    server.sessions = {}
    server.pending = {}
    server.closing = False
    identity = args.socket.stat()

    def stop(signum, frame):
        raise KeyboardInterrupt()

    signal.signal(signal.SIGTERM, stop)
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        pass
    finally:
        with server.lock:
            server.closing = True
            sessions = list(server.sessions.values())
            for session in sessions:
                session.control(True)
        # All capture and audio restoration commands have their own bounds.
        # Await their completion rather than abandoning daemon threads after
        # 20 seconds while a multi-stream audio restoration is still running.
        for session in sessions:
            session.capture_done.wait()
        server.server_close()
        try:
            current = args.socket.stat()
            if (current.st_dev, current.st_ino) == (identity.st_dev, identity.st_ino):
                args.socket.unlink()
        except FileNotFoundError:
            pass
        finally:
            os.close(service_lock)


if __name__ == "__main__":
    main()
