<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>Metasequoia IME</title>
    <license file="LICENSE"/>
    <readme file="InstallerReadMe.txt"/>
    <options customize="never" require-scripts="false" hostArchitectures="arm64,x86_64"/>
    <domains enable_localSystem="false" enable_anywhere="false" enable_currentUserHome="true"/>
    <volume-check>
        <allowed-os-versions>
            <os-version min="12.0"/>
        </allowed-os-versions>
    </volume-check>
    <choices-outline>
        <line choice="default"/>
    </choices-outline>
    <choice id="default" title="Metasequoia IME">
        <pkg-ref id="app.msime.inputmethod.MetasequoiaIME.pkg"/>
    </choice>
    <pkg-ref id="app.msime.inputmethod.MetasequoiaIME.pkg" version="@VERSION@">MetasequoiaIME.pkg</pkg-ref>
</installer-gui-script>
