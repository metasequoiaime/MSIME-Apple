{
  "module": {
    "name": "entry",
    "type": "entry",
    "description": "$string:module_desc",
    "mainElement": "KeyboardExtensionAbility",
    // phone and 2in1 are the two form factors the shared contract distinguishes: the phone panel is a
    // soft keyboard, the 2in1 one is a candidate window driven by a physical keyboard.
    "deviceTypes": [
      "phone",
      "tablet",
      "2in1"
    ],
    "deliveryWithInstall": true,
    "installationFree": false,
    "pages": "$profile:main_pages",
    // Reading the system clipboard is a system_basic permission on OpenHarmony, so an ordinary
    // third-party input method is refused it however it asks: the request is granted only to a build
    // signed with a provisioning profile that carries the ACL for it. Declared so such a build works,
    // and the keyboard checks at runtime rather than presenting an empty clipboard as an empty one.
    "requestPermissions": [
      {
        // normal and system-granted: declaring it is all a keyboard needs to buzz a key.
        "name": "ohos.permission.VIBRATE",
        "reason": "$string:vibrate_permission_reason",
        "usedScene": {
          "abilities": ["KeyboardExtensionAbility"],
          "when": "inuse"
        }
      },
      {
        "name": "ohos.permission.READ_PASTEBOARD",
        "reason": "$string:clipboard_permission_reason",
        "usedScene": {
          "abilities": ["KeyboardExtensionAbility"],
          "when": "inuse"
        }
      }
    ],
    "extensionAbilities": [
      {
        "name": "KeyboardExtensionAbility",
        "srcEntry": "./ets/inputmethodextability/KeyboardExtensionAbility.ets",
        "description": "$string:keyboard_ability_desc",
        "label": "$string:keyboard_ability_label",
        "type": "inputMethod",
        "exported": true
      }
    ]
  }
}
