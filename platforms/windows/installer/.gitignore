# Local package staging and compiled installers are regenerated by the
# packaging scripts. They can contain several hundred MiB of binaries and
# dictionaries and must never be committed from a worktree.
Output/
server_exe/
tsf_dll/
app_data/
MetasequoiaIME.ico
/THIRD_PARTY_NOTICES.txt
/LICENSE.txt

# Local signing certificates are machine-owned secrets.
*.cer
*.crt
*.pfx
*.p12
*.pvk
*.spc
