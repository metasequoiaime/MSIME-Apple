<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Android 12 起启动画面由系统画。这个宿主一个属性都没配过，于是它画的是一块空白的浅色屏：
      没有标、没有配色，然后直接闪到内容。这里把它配成这个应用自己的样子。

      minSdk 是 28，所以 28 到 30 仍然只有窗口背景——补上那一段需要引入 core-splashscreen 依赖，
      没有为此新增依赖。那三个版本上的观感与改动前一致，不是回退。
    -->
    <style name="Theme.MSIME" parent="Theme.MSIME.Base">
        <!-- 纯色窗口背景：背景是一张 drawable 时，系统会退回只画背景、不画图标的旧路径。 -->
        <item name="android:windowBackground">@color/mist</item>
        <item name="android:windowSplashScreenBackground">@color/mist</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/app_icon_field</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_mark</item>
        <!-- 与描边动画等长。系统最多给 1000ms，超过就自己截断。 -->
        <item name="android:windowSplashScreenAnimationDuration">640</item>
    </style>
</resources>
