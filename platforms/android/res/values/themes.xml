<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Material 3 rather than the framework's Theme.Material: the host uses MaterialCardView, MaterialButton and BottomNavigationView, and those resolve their own theme attributes. -->
    <!-- 基础主题与启动画面分开：values-v31 在上面叠启动画面属性，其余一律共用这一份。 -->
    <style name="Theme.MSIME" parent="Theme.MSIME.Base" />

    <style name="Theme.MSIME.Base" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/forest</item>
        <item name="colorOnPrimary">@color/surface</item>
        <item name="colorSecondary">@color/needle</item>
        <item name="colorTertiary">@color/cone</item>
        <item name="android:colorBackground">@color/mist</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/ink</item>

        <!-- Every role the theme leaves out is resolved from Material 3's own baseline, and that baseline is violet: the bottom bar took its background from colorSurfaceContainer and its active indicator from colorSecondaryContainer, so both rendered lilac next to the forest palette. The container and outline roles below are the ones these pages actually resolve; the surface container ramp is given in full because a role omitted here reappears as violet the moment a component reaches for it. -->
        <item name="colorPrimaryContainer">@color/surface_variant</item>
        <item name="colorOnPrimaryContainer">@color/forest</item>
        <item name="colorSecondaryContainer">@color/surface_variant</item>
        <item name="colorOnSecondaryContainer">@color/forest</item>
        <item name="colorSurfaceVariant">@color/surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorSurfaceContainerLowest">@color/surface</item>
        <item name="colorSurfaceContainerLow">@color/surface</item>
        <item name="colorSurfaceContainer">@color/surface</item>
        <item name="colorSurfaceContainerHigh">@color/mist</item>
        <item name="colorSurfaceContainerHighest">@color/mist</item>
        <item name="colorOutline">@color/hairline</item>
        <item name="colorOutlineVariant">@color/hairline</item>

        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- The rounded badge behind each feature tile's glyph. -->
    <!-- 关于页那几块：段标题、段脚注、和承载行的卡片。 -->
    <style name="AboutSectionHeading" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">20dp</item>
        <item name="android:layout_marginStart">4dp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="AboutSectionFooter" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:layout_marginStart">4dp</item>
        <item name="android:layout_marginEnd">4dp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="AboutCard" parent="Widget.Material3.CardView.Filled">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="cardCornerRadius">18dp</item>
        <item name="cardElevation">0dp</item>
        <item name="cardBackgroundColor">@color/surface</item>
    </style>

    <style name="Shape.Badge" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>

    <style name="Shape.Avatar" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>
</resources>
