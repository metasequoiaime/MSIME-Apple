{"skins":[{"name":"鼠尾草晨雾","description":"奶油白与鼠尾草绿铺成安静的晨雾花园，背景描绘薄雾中的圆叶香草、细小露珠与远处柔和丘陵；圆润卵石键采用哑光陶土质感，边缘轻柔无锐角，点缀极简叶片与微弱网点纹理。","background":"#F5F0E6","keyBackground":"#FFFDF7","keyForeground":"#24382E","accent":"#315A48","actionBackground":"#315A48","gradientEnd":"#E3EBDD","gradientHorizontal":false,"keyShape":"pebble","keyMaterial":"flat","cornerRadius":12,"borderWidth":0,"shadow":0.08,"pattern":1,"monospaced":false},{"name":"奶油月光","description":"以奶油白月光照亮静谧的鼠尾草温室，背景描绘拱形玻璃窗、垂落藤蔓、月桂枝与一轮朦胧月影；胶囊键呈半透明磨砂玻璃质感，叠加柔和纵向渐变和细腻高光，营造安静通透的夜间氛围。","background":"#F3F1E8","keyBackground":"#EEF4EC","keyForeground":"#20382D","accent":"#315A48","actionBackground":"#315A48","gradientEnd":"#E0EADD","gradientHorizontal":true,"keyShape":"capsule","keyMaterial":"glass","cornerRadius":20,"borderWidth":1,"shadow":0.18,"pattern":3,"monospaced":false},{"name":"香草信笺","description":"奶油色手工信笺铺在鼠尾草书桌上，背景描绘一束压花香草、木质印章、细麻线与半开的诗集，构成温柔的静物插画；票券形按键采用细腻纸张材质，带窄边框、轻微纤维纹理和低调的装饰分隔线。","background":"#F6F0E3","keyBackground":"#FFFCF4","keyForeground":"#263A30","accent":"#315A48","actionBackground":"#315A48","gradientEnd":"#E1E9DA","gradientHorizontal":false,"keyShape":"ticket","keyMaterial":"paper","cornerRadius":6,"borderWidth":1,"shadow":0.12,"pattern":2,"monospaced":false}]}