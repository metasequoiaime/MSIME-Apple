{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MSIME Client Preview",
  "version": "0.1.0",
  "identifier": "app.msime.client.preview",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "水杉输入法 · 设置", "width": 800, "height": 780, "minWidth": 360, "minHeight": 540 }],
    "security": { "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost https://msime.app" }
  },
  "bundle": { "active": false }
}
